---
import merge from 'lodash.merge';
import { SEO } from 'astro-seo';

import type { SEOProps } from 'astro-seo';

import { SITE, METADATA } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';
import type { OpenGraph } from '~/utils/images';
import { useTranslations } from '~/i18n/utils';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const t = useTranslations(Astro.currentLocale as Parameters<typeof useTranslations>[0]);

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const mergedProps: Record<string, any> = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: Astro.currentLocale || 'en',
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: t('meta.title.default'),
    titleTemplate: t('meta.title.template'),
    description: t('meta.description'),
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
);
const og: OpenGraph = await adaptOpenGraphImages(mergedProps?.openGraph, Astro.site);
const firstImage = og?.images?.[0];

const seoProps: SEOProps = {
  title: mergedProps.title,
  titleTemplate: mergedProps.titleTemplate,
  canonical: mergedProps.canonical,
  noindex: mergedProps.noindex,
  nofollow: mergedProps.nofollow,
  description: mergedProps.description,
  openGraph: firstImage?.url
    ? {
        basic: { title: mergedProps.title, type: og.type || 'website', image: firstImage.url, url: og.url || mergedProps.canonical },
        optional: { description: mergedProps.description, locale: og.locale, siteName: og.site_name },
        image: { url: firstImage.url, width: firstImage.width, height: firstImage.height },
      }
    : undefined,
  twitter: {
    card: mergedProps.twitter?.cardType,
    site: mergedProps.twitter?.site,
    creator: mergedProps.twitter?.handle,
  },
  surpressWarnings: true,
};
---

<SEO {...seoProps} />
