---
import { Icon } from 'astro-icon/components';
import logo from '~/assets/images/pragmasoft.svg';
import { getPermalink } from '~/utils/permalinks';
import { useTranslations } from '~/i18n/utils';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'uk';
const t = useTranslations(locale);
const href = getPermalink(`${locale}/conference`);
// The banner points at the conference page, so it is not shown there.
const onConferencePage = /\/conference\/?$/.test(Astro.url.pathname);
---

{
  !onConferencePage && (
    <div class="conf-banner" role="region" aria-label={t('banner.conference.link')}>
      <img class="conf-banner-logo" src={logo.src} alt="" width="320" height="238" aria-hidden="true" />
      <img class="conf-banner-logo right" src={logo.src} alt="" width="320" height="238" aria-hidden="true" />
      <a class="conf-banner-link" href={href}>
        <span>{t('banner.conference.text')}</span>{' '}
        <span class="conf-banner-cta">{t('banner.conference.link')}</span>
      </a>
      <button type="button" class="conf-banner-close" aria-label={t('banner.close')}>
        <Icon name="tabler:x" class="w-4 h-4" />
      </button>
    </div>
  )
}

<script>
  // One bundled module for the whole site session. With the ClientRouter a page swap does not re-run
  // identical inline scripts, so the state is applied on every swap/page-load instead.
  const KEY = 'conference-2026-banner-closed';
  const isClosed = () => {
    try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; }
  };
  const over = () => Date.now() > Date.UTC(2026, 11, 10, 22, 0); // after the last talk
  const apply = () => {
    const hide = over() || isClosed();
    document.querySelectorAll<HTMLElement>('.conf-banner').forEach((el) => { el.hidden = hide; });
  };
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest('.conf-banner-close');
    if (!btn) return;
    try { sessionStorage.setItem(KEY, '1'); } catch { /* storage blocked: closes for this page only */ }
    apply();
    btn.closest<HTMLElement>('.conf-banner')!.hidden = true;
  });
  document.addEventListener('astro:after-swap', apply);
  document.addEventListener('astro:page-load', apply);
  apply();
</script>

<style>
  .conf-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    min-height: 2.25rem;
    padding: 0.5rem 2.75rem 0.5rem 4.75rem;
    overflow: hidden;
    background: #ffb700;
    color: #101010; /* 10.9:1 on marigold */
    font: 400 1rem/1.3 Roboto, ui-sans-serif, sans-serif;
    text-align: center;
  }
  .conf-banner[hidden] { display: none; }
  /* The logo, oversized and cropped, so the banner reads as a few coloured triangles */
  .conf-banner-logo {
    position: absolute;
    left: -7.4rem;
    top: -3.4rem;
    width: 12rem;
    height: auto;
    rotate: -14deg;
    pointer-events: none;
  }
  .conf-banner-logo.right { display: none; left: auto; right: -5rem; top: -4rem; rotate: 22deg; scale: -1 1; }
  @media (min-width: 900px) {
    .conf-banner-logo { left: calc(50% - 44rem); top: -5.2rem; width: 20rem; }
    .conf-banner-logo.right { display: block; right: calc(50% - 44rem); }
  }
  /* The whole banner is the link: the anchor's ::after covers it, the close button sits above */
  .conf-banner-link { position: relative; color: inherit; text-decoration: none; text-wrap: balance; }
  .conf-banner-link::after { content: ''; position: absolute; inset: -0.5rem -100vw; }
  .conf-banner-cta { font-weight: 400; text-decoration: underline; text-underline-offset: 0.2em; white-space: nowrap; }
  .conf-banner:hover .conf-banner-cta { text-decoration-thickness: 2px; }
  .conf-banner-link:focus-visible { outline: none; }
  .conf-banner:has(.conf-banner-link:focus-visible) { outline: 2px solid #101010; outline-offset: -4px; }
  .conf-banner-close:focus-visible { outline: 2px solid #101010; outline-offset: 2px; border-radius: 4px; }
  .conf-banner-close {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: inherit;
    z-index: 1;
    cursor: pointer;
    transition: background-color 150ms ease-out, rotate 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .conf-banner-close:hover { rotate: 90deg; }
  .conf-banner-close:hover { background: rgb(70 70 70 / 14%); }
</style>
