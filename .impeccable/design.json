  "narrative": {
    "northStar": "The Paper Workshop",
    "overview": "The site reads as a stack of flat, saturated paper sheets, each holding one section of the story, with hand-built paper creatures and parallax paper-cut scenery on top. The type is quiet and light so the colour and the paper imagery carry the personality. The conference page extends it as Strata: sky, marigold, mint and slate sheets stacked with faceted triangle seams, low-poly clouds, an origami kite and scroll-speed parallax.",
    "keyCharacteristics": [
      "One flat colour band per section; the band colour is the section's identity.",
      "Light-weight type (Roboto 300) at generous size; condensed uppercase for navigation.",
      "Pill-shaped buttons; soft 8px inputs.",
      "Papercraft illustration and parallax layers carry decoration.",
      "Light and dark modes both exist; the dark page is a deep navy.",
      "Faceted triangles (seams, lattice, clouds, kite, facets, hexagon portraits) are the second shape motif."
    ],
    "rules": [
      {
        "name": "The One Band, One Colour Rule",
        "body": "Each section owns exactly one band colour and never splits it with a second saturated colour. Text colour is chosen for that band.",
        "section": "colors"
      },
      {
        "name": "The Mint Is Not A Text Colour Rule",
        "body": "Mint on white is 2.05:1 and Deep Mint on white is 3.14:1. Use them for fills, rules and large icons. The one green allowed to carry text is Hero Title Green (#0d7a62); #30cbab and #19a485 stay non-text.",
        "section": "colors"
      },
      {
        "name": "The Light Weight Rule",
        "body": "Body and display text default to weight 300.",
        "section": "typography"
      },
      {
        "name": "The Unloaded Weight Rule",
        "body": "Only 100, 300 and 400 are loaded; weights 500 and 600 are synthesised.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat. Shadows appear only on floating things and the offer cards.",
        "section": "elevation"
      },
      {
        "name": "The Layer Owns Its Text Rule",
        "body": "On the conference page every layer sets one text colour (Charcoal on sky and marigold, Ink on mint, white on slate) and children inherit it.",
        "section": "colors"
      },
      {
        "name": "The Stacked Lip Exception",
        "body": "The conference page departs from Flat-By-Default on purpose, without shadows: depth is a torn seam shape plus a darker lip of the same hue, and parallax furniture behind the content column.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give each section one band colour and pick its text colour for contrast.",
      "Do keep body copy at Roboto 300 and headlines at Ubuntu Condensed 300 at 40px.",
      "Do use pill buttons and 8px inputs.",
      "Do let illustration and band colour carry decoration.",
      "Do build new conference surfaces from the Strata parts: a layer colour with its lip, its own text colour, furniture in the layer's tint behind the content column, and parallax gated by reduced motion and @supports.",
